+// ---------------------------------------------------------------------------
+// Generic jump table detection.
+//
+// The fixed instruction patterns above only match when the compiler emits the
+// table setup as one contiguous sequence. Newer XDK compilers interleave those
+// instructions with the bounds check and pad them with nops, so instead we
+// start at every bctr and evaluate the value moved into CTR symbolically,
+// walking backwards through the instructions that define each register.
+// ---------------------------------------------------------------------------
+
+struct SymValue
+{
+    enum Kind { Unknown, Const, Index, Addr, Load } kind{ Unknown };
+    uint32_t c{};        // Const: value. Addr/Load: table address
+    uint32_t reg{};      // Index/Addr/Load: index register
+    uint32_t scale{ 1 }; // Index/Addr/Load: multiplier applied to the index register
+    uint32_t elemSize{}; // Load: 1, 2 or 4 bytes
+    uint32_t shift{};    // Load: left shift applied to the loaded value
+    bool hasBase{};      // Load: a constant was added to the (shifted) loaded value
+    uint32_t base{};
+};
+
+struct GenericScanner
+{
+    static constexpr size_t MaxBacktrack = 64;
+
+    const uint32_t* code; // section data (big-endian words)
+    size_t sectionBase;
+    size_t count;         // instructions in section
+
+    bool Decode(size_t i, ppc_insn& insn) const
+    {
+        ppc::Disassemble(&code[i], sectionBase + i * 4, insn);
+        return insn.opcode != nullptr;
+    }
+
+    static bool StartsWith(const char* s, const char* p) { return strncmp(s, p, strlen(p)) == 0; }
+
+    // Unconditional control flow ends the straight-line region we can reason about.
+    static bool EndsBlock(const ppc_insn& insn)
+    {
+        const char* n = insn.opcode->name;
+        return strcmp(n, "b") == 0 || strcmp(n, "blr") == 0 || strcmp(n, "bctr") == 0;
+    }
+
+    // Does this instruction write general purpose register `reg`?
+    static bool Writes(const ppc_insn& insn, uint32_t reg)
+    {
+        const char* n = insn.opcode->name;
+        size_t len = strlen(n);
+
+        // Calls clobber the volatile registers.
+        if (strcmp(n, "bl") == 0 || strcmp(n, "bctrl") == 0 || strcmp(n, "blrl") == 0)
+            return reg == 0 || (reg >= 3 && reg <= 12);
+
+        // Instructions that don't write a GPR, or write FPR/VR/CR/SPR destinations.
+        if (n[0] == 'b' || StartsWith(n, "cmp") || StartsWith(n, "mt") || StartsWith(n, "tw") ||
+            StartsWith(n, "td") || StartsWith(n, "dcb") || StartsWith(n, "icb") || StartsWith(n, "sync") ||
+            StartsWith(n, "isync") || StartsWith(n, "eieio") || StartsWith(n, "lwsync") || strcmp(n, "nop") == 0 ||
+            n[0] == 'f' || n[0] == 'v' || StartsWith(n, "lf") || StartsWith(n, "lv") || StartsWith(n, "stv") ||
+            StartsWith(n, "stf") || StartsWith(n, "cr") || StartsWith(n, "mcrf"))
+        {
+            // Floating/vector loads and stores with update still write their base register.
+            if ((StartsWith(n, "lf") || StartsWith(n, "stf")) && (n[len - 1] == 'u' || (len > 2 && strcmp(n + len - 2, "ux") == 0)))
+                return (n[len - 1] == 'u' ? insn.operands[2] : insn.operands[1]) == reg;
+            return false;
+        }
+
+        // Integer stores only write their base register in update form.
+        if (StartsWith(n, "st"))
+        {
+            if (n[len - 1] == 'u')
+                return insn.operands[2] == reg;
+            if (len > 2 && strcmp(n + len - 2, "ux") == 0)
+                return insn.operands[1] == reg;
+            if (strcmp(n + len - 2, "x.") == 0 || n[len - 1] == '.') // stwcx. writes CR only
+                return false;
+            return false;
+        }
+
+        // Integer loads with update write both rD and the base register.
+        if (n[0] == 'l' && (n[len - 1] == 'u' || (len > 2 && strcmp(n + len - 2, "ux") == 0)))
+            return insn.operands[0] == reg || (n[len - 1] == 'u' ? insn.operands[2] : insn.operands[1]) == reg;
+
+        return insn.operands[0] == reg;
+    }
+
+    // Find the closest instruction before `pos` that writes `reg`.
+    // Returns SIZE_MAX if the region ends first (register is live-in).
+    size_t FindDef(size_t pos, uint32_t reg, size_t limit) const
+    {
+        ppc_insn insn;
+        for (size_t k = 1; k <= limit && k <= pos; k++)
+        {
+            size_t i = pos - k;
+            if (!Decode(i, insn))
+                return SIZE_MAX;
+            if (EndsBlock(insn))
+                return SIZE_MAX;
+            if (Writes(insn, reg))
+                return i;
+        }
+        return SIZE_MAX;
+    }
+
+    SymValue Eval(size_t pos, uint32_t reg, int depth = 0) const
+    {
+        SymValue v{};
+        if (depth > 12)
+            return v;
+
+        size_t def = FindDef(pos, reg, MaxBacktrack);
+        if (def == SIZE_MAX)
+        {
+            v.kind = SymValue::Index; // a value from outside the region: the switch index candidate
+            v.reg = reg;
+            return v;
+        }
+
+        ppc_insn insn;
+        Decode(def, insn);
+        const char* n = insn.opcode->name;
+
+        // Anything we can't interpret is an opaque value held in `reg`, which can
+        // still serve as the switch index. FindBound verifies the bounds check
+        // compares this same register and that it survives until the bctr.
+        v = { SymValue::Index, 0, reg };
+        const uint32_t* op = insn.operands;
+
+        if (strcmp(n, "lis") == 0)
+            return { SymValue::Const, op[1] << 16 };
+        if (strcmp(n, "li") == 0)
+            return { SymValue::Const, op[1] };
+        if (strcmp(n, "addi") == 0 || strcmp(n, "addis") == 0)
+        {
+            uint32_t imm = strcmp(n, "addis") == 0 ? op[2] << 16 : op[2];
+            if (op[1] == 0)
+                return { SymValue::Const, imm };
+            SymValue a = Eval(def, op[1], depth + 1);
+            if (a.kind == SymValue::Const)
+                return { SymValue::Const, a.c + imm };
+            return v;
+        }
+        if (strcmp(n, "ori") == 0)
+        {
+            SymValue a = Eval(def, op[1], depth + 1);
+            if (a.kind == SymValue::Const)
+                return { SymValue::Const, a.c | op[2] };
+            return v;
+        }
+        if (strcmp(n, "mr") == 0)
+            return Eval(def, op[1], depth + 1);
+        if (strcmp(n, "rlwinm") == 0 || strcmp(n, "slwi") == 0)
+        {
+            uint32_t sh = op[2];
+            // Only a plain left shift: rlwinm rD, rS, sh, 0, 31-sh
+            if (strcmp(n, "rlwinm") == 0 && !(op[3] == 0 && op[4] == 31 - sh))
+                return v;
+            SymValue a = Eval(def, op[1], depth + 1);
+            if (a.kind == SymValue::Const)
+                return { SymValue::Const, a.c << sh };
+            if (a.kind == SymValue::Index)
+            {
+                a.scale <<= sh;
+                return a;
+            }
+            if (a.kind == SymValue::Load && !a.hasBase)
+            {
+                a.shift += sh;
+                return a;
+            }
+            return v;
+        }
+        if (strcmp(n, "add") == 0)
+        {
+            SymValue a = Eval(def, op[1], depth + 1);
+            SymValue b = Eval(def, op[2], depth + 1);
+            if (b.kind == SymValue::Const)
+                std::swap(a, b);
+            if (a.kind != SymValue::Const)
+                return v;
+            if (b.kind == SymValue::Const)
+                return { SymValue::Const, a.c + b.c };
+            if (b.kind == SymValue::Index)
+            {
+                b.kind = SymValue::Addr;
+                b.c = a.c;
+                return b;
+            }
+            if (b.kind == SymValue::Load && !b.hasBase)
+            {
+                b.hasBase = true;
+                b.base = a.c;
+                return b;
+            }
+            return v;
+        }
+        if (strcmp(n, "lwzx") == 0 || strcmp(n, "lhzx") == 0 || strcmp(n, "lbzx") == 0)
+        {
+            uint32_t elem = n[1] == 'w' ? 4 : n[1] == 'h' ? 2 : 1;
+            if (op[1] == 0)
+                return v;
+            SymValue a = Eval(def, op[1], depth + 1);
+            SymValue b = Eval(def, op[2], depth + 1);
+            if (b.kind == SymValue::Const)
+                std::swap(a, b);
+            if (a.kind != SymValue::Const || b.kind != SymValue::Index || b.scale != elem)
+                return v;
+            SymValue r{};
+            r.kind = SymValue::Load;
+            r.c = a.c;
+            r.reg = b.reg;
+            r.elemSize = elem;
+            return r;
+        }
+        if (strcmp(n, "lwz") == 0 || strcmp(n, "lhz") == 0 || strcmp(n, "lbz") == 0)
+        {
+            uint32_t elem = n[1] == 'w' ? 4 : n[1] == 'h' ? 2 : 1;
+            if (op[2] == 0)
+                return v;
+            SymValue a = Eval(def, op[2], depth + 1);
+            if (a.kind != SymValue::Addr || a.scale != elem)
+                return v;
+            a.kind = SymValue::Load;
+            a.c += op[1];
+            a.elemSize = elem;
+            return a;
+        }
+        return v;
+    }
+
+    // Instruction index range of the function containing the jump, used when
+    // following branches back to the bounds check.
+    size_t fnStart{};
+    size_t fnEnd{};
+
+    static constexpr size_t MaxBoundBacktrack = 256;
+    static constexpr int MaxBoundDepth = 4;
+
+    // From the conditional branch at `pos` on `cr`, find the cmplwi that set it.
+    // `inclusive` is 1 for gt/le branches (index <= max) and 0 for lt (index < max).
+    bool FindCompare(size_t pos, uint32_t cr, uint32_t idxReg, uint32_t inclusive, SwitchTable& table) const
+    {
+        ppc_insn insn;
+        for (size_t k = 1; k <= MaxBoundBacktrack && k <= pos && pos - k >= fnStart; k++)
+        {
+            size_t i = pos - k;
+            if (!Decode(i, insn))
+                continue;
+            if (EndsBlock(insn))
+                return false;
+            uint32_t id = insn.opcode->id;
+            if (id == PPC_INST_CMPLWI && insn.operands[0] == cr)
+            {
+                if (insn.operands[1] != idxReg || insn.operands[2] + inclusive == 0)
+                    return false;
+                table.r = idxReg;
+                table.labels.resize(insn.operands[2] + inclusive);
+                return true;
+            }
+            // Some other compare into the same CR field means this isn't a bounds check.
+            if (StartsWith(insn.opcode->name, "cmp") && insn.operands[0] == cr)
+                return false;
+            if (Writes(insn, idxReg))
+                return false;
+        }
+        return false;
+    }
+
+    // Locate the bounds check (cmplwi crN, rIdx, max / bgt crN) guarding the jump
+    // at `pos`. If the table setup is its own basic block, follow the branches
+    // that enter it. Fails if the index register is overwritten on the way, since
+    // the switch statement reads it at the bctr.
+    bool FindBound(size_t pos, uint32_t idxReg, SwitchTable& table, int depth = 0) const
+    {
+        ppc_insn insn;
+        for (size_t k = 1; k <= MaxBoundBacktrack && k <= pos && pos - k >= fnStart; k++)
+        {
+            size_t i = pos - k;
+            if (!Decode(i, insn))
+                continue;
+            if (EndsBlock(insn))
+                return depth < MaxBoundDepth && FindBoundFromPredecessors(i + 1, idxReg, table, depth + 1);
+
+            uint32_t id = insn.opcode->id;
+            if (id == PPC_INST_BGT || id == PPC_INST_BGTLR || id == PPC_INST_BLE || id == PPC_INST_BLELR)
+            {
+                if (id == PPC_INST_BGT)
+                    table.defaultLabel = insn.operands[1];
+                return FindCompare(i, insn.operands[0], idxReg, 1, table);
+            }
+            if (Writes(insn, idxReg))
+                return false;
+        }
+        return false;
+    }
+
+    // `blockStart` can't be reached by falling through, so search the function for
+    // branches into it: `ble/blt crN, block` is itself the bounds check, and an
+    // unconditional `b block` means the check is further up that path.
+    bool FindBoundFromPredecessors(size_t blockStart, uint32_t idxReg, SwitchTable& table, int depth) const
+    {
+        uint32_t target = uint32_t(sectionBase + blockStart * 4);
+        ppc_insn insn;
+        for (size_t j = fnStart; j < fnEnd; j++)
+        {
+            uint32_t w = ByteSwap(code[j]);
+            uint32_t primary = w >> 26;
+            if (primary != 16 && primary != 18) // bc / b
+                continue;
+            if (!Decode(j, insn))
+                continue;
+
+            uint32_t id = insn.opcode->id;
+            if (id == PPC_INST_B && insn.operands[0] == target)
+            {
+                if (FindBound(j, idxReg, table, depth))
+                    return true;
+            }
+            else if ((id == PPC_INST_BLE || id == PPC_INST_BLT) && insn.operands[1] == target)
+            {
+                if (FindCompare(j, insn.operands[0], idxReg, id == PPC_INST_BLE ? 1 : 0, table))
+                    return true;
+            }
+        }
+
+        // Nested switch: the block is a case of an already-resolved jump table,
+        // so the check may be on the path into that outer switch.
+        if (caseSources != nullptr)
+        {
+            auto [begin, end] = caseSources->equal_range(target);
+            for (auto it = begin; it != end; ++it)
+            {
+                size_t outer = (it->second - sectionBase) / 4;
+                if (outer >= fnStart && outer < fnEnd && FindBound(outer, idxReg, table, depth))
+                    return true;
+            }
+        }
+        return false;
+    }
+
+    // Case label -> bctr address of the jump tables resolved so far.
+    const std::unordered_multimap<uint32_t, uint32_t>* caseSources{};
+};
+
+struct GenericScanStats
+{
+    size_t bctr{}, notTable{}, noBound{}, badLabels{}, found{};
+};
+
+static void ScanGenericTables(Image& image, std::vector<SwitchTable>& switches, GenericScanStats& stats)
+{
+    // Function ranges from .pdata, used to sanity check labels.
+    std::vector<std::pair<uint32_t, uint32_t>> functions;
+    if (const Section* pdata = image.Find(".pdata"))
+    {
+        auto* pf = (const IMAGE_CE_RUNTIME_FUNCTION*)pdata->data;
+        for (size_t i = 0; i < pdata->size / sizeof(IMAGE_CE_RUNTIME_FUNCTION); i++)
+        {
+            IMAGE_CE_RUNTIME_FUNCTION fn = pf[i];
+            fn.BeginAddress = ByteSwap(fn.BeginAddress);
+            fn.Data = ByteSwap(fn.Data);
+            if (fn.BeginAddress != 0)
+                functions.emplace_back(fn.BeginAddress, fn.BeginAddress + fn.FunctionLength * 4);
+        }
+        std::sort(functions.begin(), functions.end());
+    }
+
+    auto findFunction = [&](uint32_t addr) -> const std::pair<uint32_t, uint32_t>*
+        {
+            auto it = std::upper_bound(functions.begin(), functions.end(), std::make_pair(addr, UINT32_MAX));
+            if (it == functions.begin())
+                return nullptr;
+            --it;
+            return addr < it->second ? &*it : nullptr;
+        };
+
+    std::unordered_multimap<uint32_t, uint32_t> caseSources;
+
+    enum class Result { NotTable, NoBound, BadLabels, Found };
+
+    // Try to resolve the jump table ending in the bctr at instruction `i`.
+    auto tryTable = [&](const Section& section, GenericScanner& scanner, size_t i, SwitchTable& table) -> Result
+        {
+            // Find the mtctr feeding this bctr.
+            ppc_insn insn;
+            size_t mtctrPos = SIZE_MAX;
+            for (size_t k = 1; k <= 8 && k <= i; k++)
+            {
+                if (!scanner.Decode(i - k, insn))
+                    break;
+                if (insn.opcode->id == PPC_INST_MTCTR)
+                {
+                    mtctrPos = i - k;
+                    break;
+                }
+                if (GenericScanner::EndsBlock(insn))
+                    break;
+            }
+            if (mtctrPos == SIZE_MAX)
+                return Result::NotTable;
+
+            uint32_t ctrReg = insn.operands[0];
+            uint32_t bctrAddr = uint32_t(section.base + i * 4);
+            const auto* fn = findFunction(bctrAddr);
+            if (fn != nullptr && fn->first >= section.base && fn->second <= section.base + section.size)
+            {
+                scanner.fnStart = (fn->first - section.base) / 4;
+                scanner.fnEnd = (fn->second - section.base) / 4;
+            }
+            else
+            {
+                // No unwind info (leaf function): only look nearby.
+                scanner.fnStart = i > 4096 ? i - 4096 : 0;
+                scanner.fnEnd = std::min(scanner.count, i + 4096);
+            }
+
+            // Fallback for absolute tables placed inline right after the bctr with no
+            // bounds check (every path into the block sets the index, sometimes as a
+            // constant). The table then runs up to the first case label.
+            auto tryInlineTable = [&]() -> bool
+                {
+                    size_t def = scanner.FindDef(mtctrPos, ctrReg, GenericScanner::MaxBacktrack);
+                    ppc_insn load;
+                    if (def == SIZE_MAX || !scanner.Decode(def, load) || load.opcode->id != PPC_INST_LWZX)
+                        return false;
+                    for (int order = 0; order < 2; order++)
+                    {
+                        uint32_t baseReg = load.operands[order ? 2 : 1], idxReg = load.operands[order ? 1 : 2];
+                        SymValue b = scanner.Eval(def, baseReg);
+                        if (b.kind != SymValue::Const || b.c != bctrAddr + 4)
+                            continue;
+                        // Index scaled by 4: rlwinm rIdxScaled, rIdx, 2, 0, 29
+                        size_t sdef = scanner.FindDef(def, idxReg, GenericScanner::MaxBacktrack);
+                        ppc_insn shift;
+                        if (sdef == SIZE_MAX || !scanner.Decode(sdef, shift) || shift.opcode->id != PPC_INST_RLWINM ||
+                            shift.operands[2] != 2 || shift.operands[3] != 0 || shift.operands[4] != 29)
+                            return false;
+                        uint32_t r = shift.operands[1];
+                        // r must still hold the index at the bctr.
+                        for (size_t k = sdef + 1; k < i; k++)
+                        {
+                            ppc_insn x;
+                            if (scanner.Decode(k, x) && GenericScanner::Writes(x, r))
+                                return false;
+                        }
+                        uint32_t firstLabel = UINT32_MAX;
+                        std::vector<size_t> labels;
+                        for (uint32_t addr = b.c; addr < firstLabel && labels.size() < 4096; addr += 4)
+                        {
+                            uint32_t entry = ByteSwap(*(const uint32_t*)image.Find(addr));
+                            bool inFunction = fn ? (entry >= fn->first && entry < fn->second)
+                                                 : (entry > b.c && entry < bctrAddr + 0x4000);
+                            if (!inFunction || (entry & 3) || entry <= addr)
+                                break;
+                            labels.push_back(entry);
+                            firstLabel = std::min(firstLabel, entry);
+                        }
+                        if (labels.size() < 2 || b.c + labels.size() * 4 != firstLabel)
+                            return false;
+                        table.r = r;
+                        table.labels = std::move(labels);
+                        table.base = bctrAddr;
+                        table.type = SWITCH_ABSOLUTE;
+                        table.tableAddress = b.c;
+                        table.elemSize = 4;
+                        return true;
+                    }
+                    return false;
+                };
+
+            SymValue target = scanner.Eval(mtctrPos, ctrReg);
+            bool absolute = target.kind == SymValue::Load && target.elemSize == 4 && !target.hasBase && target.shift == 0;
+            bool relative = target.kind == SymValue::Load && target.hasBase;
+            if (!absolute && !relative)
+                return tryInlineTable() ? Result::Found : Result::NotTable;
+
+            if (!scanner.FindBound(i, target.reg, table) || table.labels.empty() || table.labels.size() > 4096)
+            {
+                table = SwitchTable{};
+                return tryInlineTable() ? Result::Found : Result::NoBound;
+            }
+
+            const auto* tableData = (const uint8_t*)image.Find(target.c);
+            if (tableData == nullptr)
+                return Result::BadLabels;
+
+            for (size_t j = 0; j < table.labels.size(); j++)
+            {
+                uint32_t entry;
+                if (target.elemSize == 4)
+                    entry = ByteSwap(((const uint32_t*)tableData)[j]);
+                else if (target.elemSize == 2)
+                    entry = ByteSwap(((const uint16_t*)tableData)[j]);
+                else
+                    entry = tableData[j];
+                table.labels[j] = absolute ? entry : target.base + (entry << target.shift);
+            }
+
+            // Labels must be aligned code inside the same function as the jump.
+            for (size_t label : table.labels)
+            {
+                bool inSection = label >= section.base && label < section.base + section.size && (label & 3) == 0;
+                bool inFunction = fn == nullptr || (label >= fn->first && label < fn->second);
+                if (!inSection || !inFunction)
+                {
+                    fmt::println(stderr, "warning: jump table at {:X} has labels outside its function, skipped", bctrAddr);
+                    return Result::BadLabels;
+                }
+            }
+
+            // Key the table on the bctr itself; the recompiler arms the table at
+            // `base` and consumes it at the next bctr.
+            table.base = bctrAddr;
+            table.type = absolute ? SWITCH_ABSOLUTE : (target.elemSize == 1 ? SWITCH_BYTEOFFSET : SWITCH_SHORTOFFSET);
+            table.tableAddress = target.c;
+            table.elemSize = target.elemSize;
+            return Result::Found;
+        };
+
+    for (const auto& section : image.sections)
+    {
+        if (!(section.flags & SectionFlags_Code))
+            continue;
+
+        GenericScanner scanner{ (const uint32_t*)section.data, section.base, section.size / 4 };
+        scanner.caseSources = &caseSources;
+
